#include <iostream>
#include <string>
using namespace std;

class Book
{
private:
    int bookID;
    string title;
    string author;
    double price;

public:

    // Function to set book details
    void setDetails(int id, string t, string a, double p)
    {
        bookID = id;
        title = t;
        author = a;
        price = p;
    }

    // Function to display book details
    void displayDetails() const
    {
        cout << "Book ID: " << bookID << "\n";
        cout << "Title: " << title << "\n";
        cout << "Author: " << author << "\n";
        cout << "Price: Rs." << price << "\n";
        cout << "____________________\n";
    }
};

int main()
{
    const int MAX_BOOKS = 2;

    // Array of book objects
    Book books[MAX_BOOKS];

    // Store book details
    books[0].setDetails(101, "C++ Programming",
                        "Bjarne Stroustrup", 500);

    books[1].setDetails(102, "Object Oriented Programming",
                        "Robert Lafore", 650);

    cout << "=== Digital Bookstore Inventory ===\n\n";

    cout << "Book 1 Details:\n";
    books[0].displayDetails();

    cout << "\nBook 2 Details:\n";
    books[1].displayDetails();

    return 0;
}