#include <iostream>
#include <string>
using namespace std;

class student
{
private:
    int rollNumber;
    string Name;
    string course;
    int admissionYear;

public:

    // Function to input student data
    void inputDetails()
    {
        cout << "Enter roll number: ";
        cin >> rollNumber;
        cin.ignore();

        cout << "Enter Name: ";
        getline(cin, Name);

        cout << "Enter course: ";
        getline(cin, course);

        cout << "Enter Admission Year: ";
        cin >> admissionYear;

        cout << "____________________\n";
    }

    // Function to display student data
    void displayDetails() const
    {
        cout << "Roll No: " << rollNumber << "\n";
        cout << "Name: " << Name << "\n";
        cout << "Course: " << course << "\n";
        cout << "Admission Year: " << admissionYear << "\n";
        cout << "____________________\n";
    }

    // Function to get roll number
    int getRollNumber() const
    {
        return rollNumber;
    }
};

int main()
{
    const int Max_Student = 100;

    // Array of student objects
    student database[Max_Student];

    // Variable to keep track of number of students
    int currentcount = 0;
    int choice;

    cout << "=== College Record Digitalisation System ===\n";

    do
    {
        // Display Menu
        cout << "\n1. Add Student Record\n";
        cout << "2. Display All Student Records\n";
        cout << "3. Search Student by Roll Number\n";
        cout << "4. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        cout << "\n";

        switch(choice)
        {
            case 1:
                if(currentcount < Max_Student)
                {
                    cout << "Enter details of Student "
                         << currentcount + 1 << "\n";
                    cout << "____________________\n";

                    database[currentcount].inputDetails();
                    currentcount++;

                    cout << "Student record added successfully!\n";
                }
                else
                {
                    cout << "Database is full!\n";
                }
                break;

            case 2:
                if(currentcount == 0)
                {
                    cout << "No student records available.\n";
                }
                else
                {
                    cout << "\n=== All Student Records ===\n";

                    for(int i = 0; i < currentcount; i++)
                    {
                        database[i].displayDetails();
                    }
                }
                break;

            case 3:
            {
                int searchRoll;
                bool found = false;

                cout << "Enter roll number to search: ";
                cin >> searchRoll;

                for(int i = 0; i < currentcount; i++)
                {
                    if(database[i].getRollNumber() == searchRoll)
                    {
                        cout << "\nStudent Found:\n";
                        database[i].displayDetails();
                        found = true;
                        break;
                    }
                }

                if(!found)
                {
                    cout << "Student record not found.\n";
                }
                break;
            }

            case 4:
                cout << "Exiting program...\n";
                break;

            default:
                cout << "Invalid choice!\n";
        }

    } while(choice != 4);

    return 0;
} m